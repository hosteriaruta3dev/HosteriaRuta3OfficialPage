# Copiá este archivo a .env.local y completá los valores.
# SESSION_SECRET: secreto para firmar la sesión del admin (cualquier string largo).
# ADMIN_PASSWORD: contraseña para ingresar al panel de administración.
SESSION_SECRET=generá-un-secreto-largo-aleatorio
ADMIN_PASSWORD=una-contraseña-fuerte

# Supabase (Postgres + Storage). OBLIGATORIO.
# URL pública y publishable key (seguras de exponer, RLS aplica).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (equivalente a service_role). SECRETO: solo server, NUNCA con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
