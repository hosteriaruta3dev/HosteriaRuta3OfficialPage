# Copiá este archivo a .env.local y completá los valores.
# SESSION_SECRET: secreto para firmar la sesión del admin (cualquier string largo).
# ADMIN_PASSWORD: contraseña para ingresar al panel de administración.
SESSION_SECRET=generá-un-secreto-largo-aleatorio
ADMIN_PASSWORD=una-contraseña-fuerte

# Persistencia en Supabase (Postgres + Storage). OPCIONAL:
# Si no completás estos valores, la app usa un archivo local (data/store.json
# y public/uploads/) — ideal para desarrollo. En Vercel, completalos.
# SUPABASE_URL: Supabase → Project Settings → API → Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role (secreto, solo server).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=